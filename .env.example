# --- Server (runtime, not baked into any image) ---
DATABASE_URL=postgres://sealed:<password>@host.docker.internal:5432/sealed?sslmode=disable
JWT_SECRET=<random-64-char-string>
BAO_ADDR=https://host.docker.internal:8200
BAO_TOKEN=<openbao-token>
RESEND_API_KEY=<new-resend-key>
RESEND_SUPPORT_MAIL=support@yourdomain.com
RESEND_REPLY_TO_MAIL=support@yourdomain.com
FE_SIGNUP_URL=http://localhost:3000/signup
FE_HOSTNAME=http://localhost:3000

# --- Dashboard (build-time, public) ---
VITE_SERVER_URL=http://localhost:8080/api
